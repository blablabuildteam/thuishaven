# Database (Vercel Postgres / Neon — auto via marketplace)
DATABASE_URL=postgresql://user:password@localhost:5432/thuishaven
# DATABASE_URL_UNPOOLED=  # migrations indien nodig

# App URL (webhooks / availability links / Auth.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=
# Op Vercel: AUTH_URL=https://jouw-project.vercel.app

# ── Auth (medewerkers) ──────────────────────────────────
# Invite-only: admins nodigen uit via /admin/gebruikers → Brevo-mail
#
# Bootstrap (eerste admin, tot accounts in DB staan):
AUTH_ADMIN_EMAILS=naam@thuishaven.nl
AUTH_ALLOWED_EMAILS=naam@thuishaven.nl,collega@thuishaven.nl
AUTH_PASSWORD=vervang-dit-wachtwoord
# AUTH_PASSWORD_HASH= (bcrypt)
# AUTH_USERS_JSON=[{"email":"naam@thuishaven.nl","name":"Naam","password":"geheim","role":"admin"}]
#
# Uitnodigingen + wachtwoord reset (Brevo transactional)
AUTH_FROM_EMAIL=noreply@thuishaven.nl
AUTH_FROM_NAME=Thuishaven Tools
AUTH_ALLOWED_DOMAINS=thuishaven.nl,blablabuild.com
AUTH_INVITE_TTL_HOURS=168
AUTH_RESET_TTL_HOURS=1
# AUTH_ALLOW_ADMIN_PASSWORD=true  # dev: admin mag nog tijdelijk wachtwoord zetten

# ── Shared (critical voor beide tools) ──────────────────
# Brevo — read-only campagne metrics (GEEN send)
# Gebruik een API key (xkeysib-...), geen SMTP key (xsmtpsib-...)
BREVO_API_KEY=
# BREVO_SENDER_EMAIL=   # alleen nodig later voor versturen
# BREVO_SENDER_NAME=Thuishaven Events

# AI (chat + outreach personalisatie) — minstens één
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_API_KEY=

# ── Dashboard: ticketing (read-only ingest) ─────────────
# Weeztix — OAuth client (tokens worden na koppelen in de database bewaard;
# access token verloopt na ~3 dagen, refresh token is éénmalig)
WEEZTIX_CLIENT_ID=
WEEZTIX_CLIENT_SECRET=
WEEZTIX_API_URL=https://api.weeztix.com
WEEZTIX_COMPANY_GUID=
WEEZTIX_REDIRECT_URI=http://localhost:3000/api/integrations/weeztix/callback
# Alleen bootstrap / fallback — liever via Koppelingen → Opnieuw koppelen
# WEEZTIX_ACCESS_TOKEN=
# WEEZTIX_REFRESH_TOKEN=
# Legacy alias (zelfde als access token):
# WEEZTIX_API_KEY=
RA_API_KEY=
# Resident Advisor — geen officiële sales-API. Publieke listings via GraphQL:
RA_VENUE_ID=109027
# TicketSwap — publieke venue-listings (Thuishaven = 3517). Geen officiële sales-API.
TICKETSWAP_LOCATION_ID=3517
TICKETSWAP_LOCATION_SLUG=thuishaven
# TICKETSWAP_API_KEY=   # optioneel Developer-Token als TicketSwap die geeft
#
# Vercel Cron (GET /api/cron/weeztix + /api/cron/ticketswap) — 08:00, 13:00, 19:00, 23:00 Amsterdam.
# Vercel stuurt Authorization: Bearer CRON_SECRET. Zet dezelfde waarde in Vercel env.
# Meerdere runs per dag vereist Pro (Hobby: max 1×/dag).
CRON_SECRET=
# Optioneel: Firecrawl als TicketSwap GraphQL/HTML geblokkeerd is
FIRECRAWL_API_KEY=
APPIC_API_KEY=
INTERNAL_TICKETING_API_URL=
INTERNAL_TICKETING_API_KEY=

# ── Dashboard: marketing ────────────────────────────────
# Meta — App ID/secret (OAuth later) + token + Instagram Business account ID
# pages_read_engagement vereist Meta App Review → later; v1: instagram_basic + instagram_manage_insights
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_IG_BUSINESS_ID=
# META_GRAPH_API_VERSION=v21.0
# Optioneel: duurzame media-kopie voor visual recognition (Vercel Blob)
# BLOB_READ_WRITE_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
YOUTUBE_API_KEY=
# Officieel Thuishaven-kanaal (niet blablabuild): youtube.com/@Thuishaven
YOUTUBE_CHANNEL_ID=UC2KhiKAhm8wIkjt2chtIUTA

# Alerts — komma-gescheiden; test: team@blablabuild.com
# Ontvangers per alert stel je in op /dashboard/alerts (deze env is fallback).
# ALERT_EMAIL_ENABLED moet true zijn, anders wordt er niets verstuurd.
ALERT_EMAIL_ENABLED=true
ALERT_NOTIFY_EMAIL=team@blablabuild.com
# Exacte adressen en/of @domeinen. Default zonder deze var: alleen team@blablabuild.com
ALERT_EMAIL_ALLOWLIST=team@blablabuild.com,@blablabuild.com,@thuishaven.nl
ALERT_FROM_EMAIL=noreply@thuishaven.nl
ALERT_FROM_NAME=Thuishaven Alerts
# Code-plafond: alleen *@thuishaven.nl en *@blablabuild.com (niet via env te verruimen)
# Fallback als Weeztix geen bruikbare ticketcap heeft (weekedities / unlimited).
# Alert ook als sold >= deze drempel. 0 of off = alleen echte sold-out / publieke types.
ALERT_WEEZTIX_SOLD_THRESHOLD=3000

# ── Outreach ────────────────────────────────────────────
KVK_API_KEY=
KVK_API_URL=https://api.kvk.nl
SALES_NOTIFY_EMAIL=

GOOGLE_PLACES_API_KEY=
ENRICHMENT_API_KEY=
# LINKEDIN_ACCESS_TOKEN=
